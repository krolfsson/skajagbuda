DATABASE_URL=postgresql://user:password@localhost:5432/bidder

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

# Stripe (required for paid unlock)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (Vercel): https://skajagbuda.se — required for correct OG/sitemap URLs

# Search engine verification (optional — paste values from Search Console / Bing Webmaster)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Admin dashboard (/admin) — set a strong random code for production
ADMIN_ACCESS_CODE=

# Public contact email shown on /kontakt and in footer
NEXT_PUBLIC_CONTACT_EMAIL=kontakt@skajagbuda.se

# Local dev: skip Stripe and run full analysis after free tier (never enable in production)
DEV_BYPASS_PAYMENT=false

# Free beta: full report without payment when true. Set false to turn the Stripe paywall on.
# Before enabling: STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET set, and a Stripe webhook endpoint at
# https://skajagbuda.se/api/webhooks/stripe for checkout.session.completed,
# checkout.session.async_payment_succeeded and checkout.session.async_payment_failed.
PAYWALL_DISABLED=true

# Booli API — optional. Only used if you have credentials (enriches Booli/Hemnet links and sold
# comparables). Without it, Hemnet/Booli links give address/rooms from the URL and the user
# pastes the listing text; hemnet.se and booli.se pages are bot-protected and are not scraped.
BOOLI_CALLER_ID=
BOOLI_API_KEY=
